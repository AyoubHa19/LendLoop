# Copy to .env.local and fill in. Never commit .env.local.

# Clerk dashboard -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Set on the Convex deployment, NOT here:
#   npx convex env set CLERK_FRONTEND_API_URL https://<your-app>.clerk.accounts.dev
