{
  "id": "LLrequestNotify1",
  "name": "LendLoop – Request notification",
  "active": false,
  "nodes": [
    {
      "id": "07295e80-20e7-475f-a5da-0ebb8c9b6576",
      "name": "Convex webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        220,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lendloop-request",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "webhookId": "4f1c0a52-6a7e-4d0b-9b8e-1e6a2c9d3f10"
    },
    {
      "id": "1b81c16d-f72a-4f3a-a8e3-53e091d39075",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// Checks the HMAC Convex put on this request (see convex/lib/hmac.ts).\n// The secret comes from the container environment, never from this workflow.\nconst crypto = require('crypto');\nconst { headers } = $input.first().json;\nconst timestamp = headers['x-lendloop-timestamp'] ?? '';\nconst signature = headers['x-lendloop-signature'] ?? '';\n// Verify the exact bytes Convex signed, not a re-serialised copy.\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n\nconst fresh = /^\\d+$/.test(timestamp) && Math.abs(Date.now() / 1000 - Number(timestamp)) <= 300;\nconst expected = 'sha256=' + crypto\n  .createHmac('sha256', $env.LENDLOOP_HMAC_SECRET)\n  .update(`${timestamp}.${raw}`)\n  .digest('hex');\nconst valid = fresh && signature.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expected));\n\nreturn [{ json: { valid, event: valid ? JSON.parse(raw) : null } }];"
      }
    },
    {
      "id": "4a5a87f0-afbb-4ad4-b751-8bfec08f8030",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b5414690-7e25-4367-a440-df097438147d",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "20a2057e-807e-4e7e-b69c-0bb2a1022721",
      "name": "Reject (401)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        420
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"invalid signature\" }",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "2ae1d88c-00a0-4207-9cbb-9c4405aa8f3d",
      "name": "Accept (200)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"received\": true }",
        "options": {}
      }
    },
    {
      "id": "f5643f09-1014-4f92-8ddd-bbd9dea64266",
      "name": "Compose email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// One short email per event. Only the fields Convex sent are used.\nconst e = $json.event;\nconst who = e.otherPartyName;\nconst dates = `${e.startDate} to ${e.endDate}`;\nconst templates = {\n  pending:   [`New request for your ${e.toolName}`, `${who} would like to borrow your ${e.toolName} from ${dates}. Open LendLoop to approve or decline it.`],\n  cancelled: [`Request cancelled: ${e.toolName}`, `${who} cancelled their request for your ${e.toolName} (${dates}).`],\n  approved:  [`Approved: ${e.toolName}`, `${who} approved your request for the ${e.toolName} (${dates}). Please return it by ${e.endDate}.`],\n  declined:  [`Declined: ${e.toolName}`, `${who} declined your request for the ${e.toolName} (${dates}).`],\n  returned:  [`Returned: ${e.toolName}`, `${who} marked the ${e.toolName} as returned. Thanks for borrowing responsibly!`],\n};\nconst [subject, body] = templates[e.status];\nreturn {\n  json: {\n    to: e.recipient.email,\n    subject,\n    text: `Hi ${e.recipient.name},\\n\\n${body}\\n\\n— LendLoop`,\n    eventId: e.eventId,\n    requestId: e.requestId,\n    recipientRole: e.recipient.role,\n  },\n};"
      }
    },
    {
      "id": "ba0fa808-e519-46c7-8293-2f5bfa83b690",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "fromEmail": "LendLoop <noreply@lendloop.local>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "smtp": {
          "id": "LLmailpitSmtp01",
          "name": "Mailpit (local SMTP)"
        }
      }
    },
    {
      "id": "3c38f4ba-b493-4fd8-9430-123345ec8e33",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Tell Convex the email went out. The key makes a retried call harmless.\nconst src = $('Compose email').item.json;\nconst body = JSON.stringify({\n  idempotencyKey: `notify:${src.eventId}`,\n  kind: 'notification_sent',\n  message: src.recipientRole === 'lender' ? 'Lender notified by email' : 'Borrower notified by email',\n  requestId: src.requestId,\n});\nconst crypto = require('crypto');\nconst timestamp = Math.floor(Date.now() / 1000).toString();\nconst signature = 'sha256=' + crypto\n  .createHmac('sha256', $env.LENDLOOP_HMAC_SECRET)\n  .update(`${timestamp}.${body}`)\n  .digest('hex');\nreturn { json: { body, timestamp, signature } };"
      }
    },
    {
      "id": "7dbcab27-119a-4027-9484-a5f9089fd40b",
      "name": "Record in Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/activity",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Convex webhook": {
      "main": [
        [
          {
            "node": "Verify signature",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify signature": {
      "main": [
        [
          {
            "node": "Signature valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Signature valid?": {
      "main": [
        [
          {
            "node": "Accept (200)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject (401)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Accept (200)": {
      "main": [
        [
          {
            "node": "Compose email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compose email": {
      "main": [
        [
          {
            "node": "Send email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send email": {
      "main": [
        [
          {
            "node": "Sign write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign write-back": {
      "main": [
        [
          {
            "node": "Record in Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "errorWorkflow": "LLerrorHandler01"
  },
  "pinData": {},
  "tags": []
}
