# Copy to n8n/.env (git-ignored). Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Encrypts n8n's stored credentials. Keep it stable once set.
N8N_ENCRYPTION_KEY=

# Shared with Convex (npx convex env set LENDLOOP_HMAC_SECRET <same value>).
LENDLOOP_HMAC_SECRET=

# Your deployment's HTTP actions URL (NEXT_PUBLIC_CONVEX_SITE_URL in .env.local).
LENDLOOP_CONVEX_SITE_URL=https://<your-deployment>.convex.site

# Where workflow-error alerts go (lands in Mailpit locally).
LENDLOOP_ADMIN_EMAIL=admin@lendloop.local

TZ=Africa/Casablanca
